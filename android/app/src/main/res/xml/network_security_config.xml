<?xml version="1.0" encoding="utf-8"?>
<!--
  局域网直连需要明文 HTTP（路由器默认 http://192.168.x.x:80）。
  Android 的 domain-config 只能枚举固定域名/IP，无法覆盖任意内网 IP，
  因此这里全局放开明文；App 内的地址校验已随无用代码清理移除，
  请只在可信局域网内使用明文连接。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
